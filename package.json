{
  "name": "time-translate",
  "version": "0.9.18",
  "description": "一款简洁、高效、高颜值的输入、截图、划词翻译软件",
  "main": "./out/main/index.js",
  "author": "byliangcheng",
  "homepage": "https://github.com/antstars/TTime/",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run modules-update && npm run typecheck:node && npm run typecheck:web",
    "start": "node scripts/run-electron-vite.cjs preview",
    "dev": "node scripts/run-electron-vite.cjs dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run modules-update && npm run build && node scripts/clean-windows-dist.js && electron-builder --win --config --publish never && node scripts/build-windows-portable.js",
    "build:win:portable": "npm run modules-update && npm run build && node scripts/clean-windows-dist.js && electron-builder --win --dir --config --publish never && node scripts/build-windows-portable.js",
    "build:mac": "npm run modules-update && npm run build && electron-builder --mac --config --publish never",
    "build:linux": "npm run modules-update && npm run build && electron-builder --linux --config --publish never",
    "build:linux:ci": "npm run modules-update && npm run build && electron-builder --linux AppImage deb --config --publish never",
    "npm-i-extend-modules-update": "npm i && npm run modules-update",
    "modules-update": "node modules-update.cjs"
  },
  "dependencies": {
    "@alicloud/alimt20181012": "^1.0.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@jitsi/robotjs": "^0.6.11",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@volcengine/openapi": "^1.36.2",
    "auto-launch": "^5.0.5",
    "axios": "^1.17.0",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "fast-uri": "^3.1.2",
    "fs-extra": "^11.1.1",
    "https-proxy-agent": "^5.0.1",
    "ip-address": "^10.2.0",
    "md5": "^2.3.0",
    "md5-node": "^1.0.1",
    "node-screenshots": "^0.1.1",
    "onnxruntime-node": "^1.13.1",
    "protobufjs": "^8.6.0",
    "socks-proxy-agent": "^6.2.1",
    "sqlite3": "^6.0.1",
    "tencentcloud-sdk-nodejs-ocr": "^4.0.632",
    "tencentcloud-sdk-nodejs-tmt": "^4.0.589",
    "tslib": "^2.5.0",
    "uiohook-napi": "^1.5.0",
    "wordsninja": "^1.0.0"
  },
  "overrides": {
    "axios": "$axios",
    "protobufjs": "$protobufjs",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^1.2.3",
    "@element-plus/icons-vue": "^2.0.10",
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "download": "^8.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^23.6.0",
    "electron-vite": "^1.0.14",
    "element-plus": "^2.2.26",
    "eslint": "^8.28.0",
    "eslint-plugin-vue": "^9.7.0",
    "franc": "^6.1.0",
    "prettier": "^2.7.1",
    "sass": "^1.56.2",
    "typescript": "^6.0.3",
    "vite": "^3.2.4",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.2.45",
    "vue-router": "^4.1.6",
    "vue-tsc": "^3.2.8",
    "vuedraggable": "^4.1.0"
  }
}
